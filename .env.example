# Production settings (docker-compose.yml reads these from .env)
PORT=3000
MONGO_DB=smartcampus
# Public URL users type in the browser. Must match exactly (used for the Origin check).
APP_URL=http://localhost:3000
# Set both to true when running behind an HTTPS reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false
# Hard session limit, and sign-out after this much inactivity
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30

# Outgoing mail for password resets and invitations. Without SMTP_HOST, mails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartCampus <no-reply@your-domain>

# First admin, created on startup if missing. Remove the password afterwards.
SEED_ADMIN_EMAIL=admin@example.com
# At least 10 characters
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Device gateway. The key is a mounted secret (see docker-compose.yml), never part of the repo.
ENROLL_REQUEST_TTL_MINUTES=15
ENROLL_RATE_LIMIT=20
MAX_PENDING_ENROLLMENTS=50

# Largest audio file accepted for broadcasts, in megabytes.
MAX_AUDIO_MB=10

# Microsoft Azure / Entra ID SSO (scaffold, not functional yet)
AZURE_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=
AZURE_AUTO_PROVISION=false
