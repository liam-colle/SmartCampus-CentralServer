{
  "name": "@smartcampus/handshake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mutual device/server authentication (ECDSA P-256 + ephemeral ECDH) and AES-256-GCM channel, on node:crypto",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@smartcampus/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
